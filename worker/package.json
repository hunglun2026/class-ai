{
  "name": "class-ai-worker",
  "version": "1.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply class_ai_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply class_ai_db --remote",
    "typecheck": "tsc --noEmit",
    "test:it": "node -e \"require('fs').rmSync('.wrangler/state-it',{recursive:true,force:true})\" && wrangler d1 migrations apply class_ai_db --local --persist-to .wrangler/state-it && tsx test/answer-key-and-attachments.it.mts",
    "test:injection": "tsx test/prompt-injection.it.mts"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "hono": "^4.6.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "wrangler": "^3.90.0"
  }
}
