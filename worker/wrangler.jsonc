{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "class-ai-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "class_ai_db",
      "database_id": "75045fe0-0f48-414e-b082-72e0335d8eca"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "207691989ce24cf09a577e1359718fcd"
    },
    {
      // @cloudflare/workers-oauth-provider 內部要求的固定綁定名稱，存 MCP 的
      // client/grant/token，跟 SESSIONS（老師網頁登入）分開，避免 key 混在一起
      "binding": "OAUTH_KV",
      "id": "89451ca1117f4eab8c0c9b813866edfd"
    }
  ],
  // 老師上傳的標準答案檔（圖片/PDF）存這裡，D1 只記物件位置（D1 單列上限 2MB 放不下）。
  // 學生附件仍是「下載→轉 base64→餵給 Gemini 就丟」，不存 R2。
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "class-ai-answer-keys"
    }
  ],
  // v1.17.0 背景自動預批改：每 10 分鐘去 Classroom 拉新繳交、叫 AI 評（lib/autograde.ts）
  "triggers": { "crons": ["*/10 * * * *"] },
  // 這裡是「正式環境」的值（wrangler deploy 會用）。
  // 本機開發時 worker/.dev.vars 會覆蓋掉這三個 key，改回 localhost。
  "vars": {
    "ENVIRONMENT": "production",
    // 前端與 API 同網域（Pages 把 /api/* 轉給這支 Worker），Google 登入導回也走同一個網域
    "GOOGLE_REDIRECT_URI": "https://classai.hunglun.com/api/auth/google/callback",
    "APP_URL": "https://classai.hunglun.com",
    // 跟著 worker/package.json 的 version 走，每次改版一起手動更新兩處；
    // 只是給 /health 顯示用，方便發布後打線上端點確認真的換新版本上線
    "APP_VERSION": "1.17.0",
    // 每位老師的 AI 評分上限：一位老師用過頭不會影響其他老師（改這裡就好，不用改程式）
    "DAILY_AI_LIMIT": "200",
    "MINUTE_AI_LIMIT": "20",
    // 背景自動預批每 10 分鐘最多評幾位（部署後看排程有沒有碰到 CPU 上限再調）
    "AUTOGRADE_PER_RUN": "15"
  }
}
