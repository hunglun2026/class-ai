{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "class-ai-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "class_ai_db",
      "database_id": "75045fe0-0f48-414e-b082-72e0335d8eca"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "207691989ce24cf09a577e1359718fcd"
    }
  ],
  // R2 目前程式沒用到（附件是下載→轉 base64→餵給 Gemini 就丟）。
  // 真的要存附件時再補：token 加 Workers R2 Storage:Edit、建 bucket、加回這段。
  // 這裡是「正式環境」的值（wrangler deploy 會用）。
  // 本機開發時 worker/.dev.vars 會覆蓋掉這三個 key，改回 localhost。
  "vars": {
    "ENVIRONMENT": "production",
    "GOOGLE_REDIRECT_URI": "https://class-ai-worker.hunglun2026.workers.dev/api/auth/google/callback",
    "APP_URL": "https://classai.hunglun.com",
    // 跟著 worker/package.json 的 version 走，每次改版一起手動更新兩處；
    // 只是給 /health 顯示用，方便發布後打線上端點確認真的換新版本上線
    "APP_VERSION": "1.1.2"
  }
}
