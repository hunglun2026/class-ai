{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "class-ai-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "class_ai_db",
      "database_id": "75045fe0-0f48-414e-b082-72e0335d8eca"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "207691989ce24cf09a577e1359718fcd"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "class-ai-attachments"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "GOOGLE_REDIRECT_URI": "http://localhost:8787/api/auth/google/callback",
    "APP_URL": "http://localhost:5173"
  }
}
